+// distances follow the original shell, x/y/z, then source-vertex order.
+function scan(P, cell, query, reach) {
+  const lo = [0, 1, 2].map((axis) => {
+    let m = Infinity; for (let i = axis; i < P.length; i += 3) m = Math.min(m, P[i]);
