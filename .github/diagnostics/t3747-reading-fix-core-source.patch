index 0000000000..ccfb7df01f
--- /dev/null
+++ b/chicago/4d/changelog.d/T-3747.json
@@ -0,0 +1,7 @@
+{
+  "title": "Tree crowns catch the light",
+  "kind": "improvement",
+  "items": [
+    "Woodland and street trees, woody shrubs and vines have rounded foliage shading and warmer backlit leaves. Sunlight passing through leaves follows the shadows. Full adds smaller, layered sprays on fine twigs within 14 metres; capable devices show fine leaf relief. Balanced and Light use smaller woodland textures; their tree meshes retain their existing detail. Switching season and detail safely rebuilds the crowns."
+  ]
+}
diff --git a/chicago/4d/changelog.d/T-3789.json b/chicago/4d/changelog.d/T-3789.json
new file mode 100644
index 0000000000..9a44863b71
--- /dev/null
+++ b/chicago/4d/changelog.d/T-3789.json
@@ -0,0 +1,8 @@
+{
+  "title": "Younger readers' tellings caught up with rewritten building notes",
+  "kind": "fix",
+  "items": [
+    "Thirty-six of the house notes rewritten this week read again at the 8-10 age: the turret windows, the four chimney pots and the new finials now say what the houses show.",
+    "Tellings of notes that no longer exist are retired, so a card never offers words for a line it does not show."
+  ]
+}
