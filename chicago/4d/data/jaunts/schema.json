{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
      "maxLength": 90
    },
    "content_version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^<>]*$"
    },
    "premise": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260,
      "pattern": "^[^<>]*$"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[^<>]*$"
    },
    "scene": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "featured": {
      "type": "boolean"
    },
    "menu_group": {
      "enum": [
        "Places",
        "People",
        "Architecture",
        "Stories",
        "Errands",
        "Work",
        "Build log"
      ],
      "description": "T-3584: the Jaunts menu's filter this jaunt sits under, the same seven in every year: Places (tours of buildings, streets and the river), People (the people who lived there), Architecture (styles and architects), Stories (legends and events told as a story), Errands (an everyday task in town), Work (a trade or a job of work), Build log (the project's own progress walk, listed last). Distinct from the keepsake family, which is the daybook's."
    },
    "grade_band": {
      "enum": [
        "K-2",
        "3-5",
        "6-8",
        "9-10",
        "11-12"
      ],
      "description": "T-3590: the US school grades the jaunt's words are written for, in the Common Core bands (K-2, 3-5, 6-8, 9-10, 11-12). Measured, not guessed: tools/jaunt_reading_level.py (the mean of five grade-level formulas over every word the visitor reads) must put a jaunt for grades K-2 or 3-5 inside its band, and any other within one band."
    },
    "version_of": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "T-3590: this jaunt retells another of the same scene for a different grade band (the same walk in other words); the menu lists it beside the jaunt it retells."
    },
    "menu_rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9,
      "description": "T-3584: leads the menu, in this order, ahead of every group (owner, 2026-11-13: the household tour first, then the other Glessner jaunt)."
    },
    "plate": {
      "type": "object",
      "properties": {
        "structure": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "picture": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      },
      "required": [
        "structure"
      ],
      "additionalProperties": false,
      "description": "T-3584: the building whose held picture heads the card when the stops are anchors rather than buildings, and optionally which of its pictures."
    },
    "opening": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^<>]*$"
        },
        "read_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        }
      },
      "required": [
        "text",
        "read_s"
      ],
      "additionalProperties": false
    },
    "default_mode": {
      "enum": [
        "walk",
        "wagon",
        "horse",
        "fly",
        "instantly"
      ]
    },
    "allowed_modes": {
      "type": "array",
      "items": {
        "enum": [
          "walk",
          "wagon",
          "horse",
          "fly",
          "instantly"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "long_form": {
      "type": "boolean",
      "description": "T-3355: a story jaunt told in full; each stop's text may run 25-150 words instead of 25-60."
    },
    "ambience": {
      "description": "T-3377: the light a jaunt is walked in, a viewing choice like Settings > Time of day and Season, never a claim about the day: `hour` stands at every stop without an hour of its own, `season` at every stop without a date of its own (a dated stop is shown in its date's season, T-3459); both are given back when it ends.",
      "type": "object",
      "properties": {
        "hour": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            {
              "enum": [
                "daybreak",
                "morning",
                "daytime",
                "afternoon",
                "sunset",
                "dusk",
                "night"
              ]
            }
          ]
        },
        "season": {
          "enum": [
            "summer",
            "spring",
            "fall",
            "winter"
          ]
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "variables": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
        "maxLength": 90
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "min": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          },
          "initial": {
            "type": "integer"
          },
          "unit": {
            "enum": [
              "count",
              "cents",
              "preference",
              "minutes"
            ]
          }
        },
        "required": [
          "min",
          "max",
          "initial",
          "unit"
        ],
        "additionalProperties": false
      }
    },
    "inventory": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
            "maxLength": 90
          },
          "uniqueItems": true
        },
        "initial": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
            "maxLength": 90
          },
          "uniqueItems": true
        },
        "capacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "items",
        "initial",
        "capacity"
      ],
      "additionalProperties": false
    },
    "stops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stop"
      },
      "minItems": 1,
      "maxItems": 50
    },
    "legs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180,
            "pattern": "^[^<>]*$"
          },
          "story": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180,
            "pattern": "^[^<>]*$"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "story_evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "mode": {
            "enum": [
              "walk",
              "wagon",
              "horse",
              "fly",
              "instantly"
            ],
            "description": "T-3355: how this leg travels while the visitor is on the jaunt's default mode (a long ride Instantly). Must be one of the jaunt's allowed_modes."
          }
        },
        "required": [
          "evidence"
        ],
        "additionalProperties": false,
        "dependentRequired": {
          "story": [
            "story_evidence"
          ]
        }
      }
    },
    "endings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
            "maxLength": 90
          },
          "when": {
            "$ref": "#/$defs/when"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^[^<>]*$"
          },
          "read_s": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600
          },
          "default": {
            "type": "boolean"
          },
          "completion_eligible": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "text",
          "read_s",
          "completion_eligible"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "keepsake": {
      "type": "object",
      "properties": {
        "family": {
          "enum": [
            "Provisions",
            "Livelihood",
            "Wayfinding",
            "News & Knowledge",
            "Neighbors"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "maxLength": 90
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^<>]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^<>]*$"
        }
      },
      "required": [
        "family",
        "id",
        "title",
        "text"
      ],
      "additionalProperties": false
    },
    "secondary_family": {
      "enum": [
        "Provisions",
        "Livelihood",
        "Wayfinding",
        "News & Knowledge",
        "Neighbors"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1
    },
    "review_required": {
      "type": "boolean"
    },
    "review_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[^<>]*$"
    },
    "liberties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "^[^<>]*$"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "content_version",
    "title",
    "premise",
    "category",
    "menu_group",
    "grade_band",
    "scene",
    "opening",
    "default_mode",
    "allowed_modes",
    "stops",
    "endings",
    "keepsake",
    "evidence",
    "review_required",
    "liberties"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "when": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/when"
              },
              "minItems": 1
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/when"
              },
              "minItems": 1
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/when"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "has": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
              "maxLength": 90
            }
          },
          "required": [
            "has"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "var": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
              "maxLength": 90
            },
            "op": {
              "enum": [
                "<",
                "<=",
                "==",
                ">=",
                ">",
                "!="
              ]
            },
            "value": {
              "type": "integer"
            }
          },
          "required": [
            "var",
            "op",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "set",
                "inc"
              ]
            },
            "var": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
              "maxLength": 90
            },
            "value": {
              "type": "integer"
            }
          },
          "required": [
            "op",
            "var",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "add",
                "remove"
              ]
            },
            "item": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
              "maxLength": 90
            },
            "value": {
              "const": 1
            }
          },
          "required": [
            "op",
            "item",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "destination": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "structure",
            "anchor",
            "intersection",
            "person",
            "business"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "maxLength": 90
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "choice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "maxLength": 90
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^<>]*$"
        },
        "consequence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^<>]*$"
        },
        "when": {
          "$ref": "#/$defs/when"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "next": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
              "maxLength": 90
            },
            {
              "enum": [
                "$end"
              ]
            }
          ]
        }
      },
      "required": [
        "id",
        "label",
        "consequence"
      ],
      "additionalProperties": false
    },
    "stop": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "maxLength": 90
        },
        "destination": {
          "$ref": "#/$defs/destination"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^<>]*$"
        },
        "read_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "action_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/choice"
          },
          "maxItems": 3
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "structure",
                  "person",
                  "business",
                  "source",
                  "topic"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
                "maxLength": 90
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "^[^<>]*$"
              }
            },
            "required": [
              "kind",
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "people": {
          "description": "T-3495: the people this stop calls for, by person id of the scene. While a jaunt is under way the everyday figures are held out of the scene; a stop's `people`, and the people its person links name, are the ones drawn at it.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
            "maxLength": 90
          },
          "maxItems": 24,
          "uniqueItems": true
        },
        "hosts": {
          "description": "T-3525: the people who tell this stop, each at the mark they stand at (local ENU metres) while the visitor is here, turned to the stop's stand; a host the scene has indoors comes out of the house by its nearest door. Hosts are kept in the scene like the stop's `people`, and go back about their day when the visitor walks on (renderers/web/js/jaunt-hosts.js).",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "person": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
                "maxLength": 90
              },
              "local_e": {
                "type": "number"
              },
              "local_n": {
                "type": "number"
              }
            },
            "required": [
              "person",
              "local_e",
              "local_n"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 4
        },
        "next": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
              "maxLength": 90
            },
            {
              "enum": [
                "$end"
              ]
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
            "maxLength": 90
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "narrative": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^<>]*$"
        },
        "hour": {
          "description": "T-3328: the hour the scene shows at this stop, set on arrival through api.timeOfDay (T-3331) and given back when the jaunt ends: 'HH:MM' local mean solar time, or one of the setting's named times (renderers/web/js/time-of-day.js TIME_NAMES).",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            {
              "enum": [
                "daybreak",
                "morning",
                "daytime",
                "afternoon",
                "sunset",
                "dusk",
                "night"
              ]
            }
          ]
        },
        "date": {
          "description": "T-3328: the day the stop's hour falls on ('YYYY-MM-DD'), so a named time is solved on that day's sun.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "since": {
          "description": "T-3406: how long since the stop before, the lead the stop opens with ('Four hours later', 'Four months later'). compile_jaunts.py checks it against the two stops' date and hour; in a jaunt that has one, every stop after the first has one.",
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[A-Z0-9][A-Za-z0-9 ]*[a-z]$"
        },
        "hour_evidence": {
          "description": "T-3328: the stop's own claims that give its hour; required with `hour`.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
            "maxLength": 90
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "destination",
        "text",
        "read_s",
        "evidence"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "maxLength": 90
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^<>]*$"
        },
        "confidence": {
          "enum": [
            "attested",
            "inferred",
            "reconstructed"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
            "maxLength": 90
          },
          "uniqueItems": true
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^<>]*$"
        },
        "reasoning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^<>]*$"
        },
        "liberty": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^<>]*$"
        }
      },
      "required": [
        "id",
        "text",
        "confidence",
        "sources"
      ],
      "additionalProperties": false
    }
  },
  "title": "Chicago jaunt content v1"
}
