  "lines": [
    {
      "voice": "gent",
      "kind": "greet",
      "time": "morning",
      "id": "gent-greet-f054cc",
      "text": "Good morning to you."
    },
    {
      "voice": "gent",
      "kind": "greet",
      "time": "morning",
      "id": "gent-greet-03c122",
      "text": "Morning. A fine day for a walk on the Avenue."
    },
    {
      "voice": "gent",
      "kind": "greet",
      "time": "afternoon",
      "id": "gent-greet-436f04",
      "text": "Good afternoon."
    },
    {
      "voice": "gent",
      "kind": "greet",
      "time": "afternoon",
      "id": "gent-greet-05f7bc",
      "text": "Good day to you. Mind the carriages at the corner."
    },
    {
      "voice": "gent",
      "kind": "greet",
      "time": "evening",
      "id": "gent-greet-462267",
      "text": "Good evening."
    },
    {
      "voice": "gent",
      "kind": "greet",
      "time": "evening",
      "id": "gent-greet-7ac1c7",
      "text": "Evening. You're out late on the Avenue."
    },
    {
      "voice": "gent",
      "kind": "greet",
      "id": "gent-greet-e86ada",
      "text": "How do you do?"
    },
    {
      "voice": "gent",
      "kind": "greet",
      "id": "gent-greet-a55460",
      "text": "A stranger to Prairie Avenue? Welcome. It's the finest street in the city, whatever the North Side says."
    },
    {
      "voice": "gent",
      "kind": "remark",
      "time": "morning",
      "id": "gent-remark-525002",
      "text": "The carriage is late again. I'll be late on LaSalle Street."
    },
    {
      "voice": "gent",
      "kind": "remark",
      "time": "morning",
      "id": "gent-remark-a025fb",
      "text": "Wheat was up a cent and a half yesterday. Mark my words, it won't last the week."
    },
    {
      "voice": "gent",
      "kind": "remark",
      "time": "evening",
      "id": "gent-remark-bcf4a7",
      "text": "A long day downtown. I'm glad to be home."
    },
    {
      "voice": "gent",
      "kind": "remark",
      "id": "gent-remark-0be2f0",
      "text": "Some of the Avenue has gone up to the North Side. Let them. We were here first."
    },
    {
      "voice": "gent",
      "kind": "remark",
      "id": "gent-remark-202830",
      "text": "Since the Iroquois fire, I won't take my family to any theater that can't show me its exits."
    },
    {
      "voice": "gent",
      "kind": "remark",
      "id": "gent-remark-f5a385",
      "text": "That automobile went by again. Frightened every horse from Sixteenth to Eighteenth Street."
    },
    {
      "voice": "gent",
      "kind": "remark",
      "id": "gent-remark-3a7f62",
      "text": "The Illinois Central's smoke is on the curtains again."
    },
    {
      "voice": "gent",
      "kind": "remark",
      "id": "gent-remark-52c9e6",
      "text": "When the wind comes from the southwest, you can smell the stockyards from here."
    },
    {
      "voice": "gent",
      "kind": "remark",
      "id": "gent-remark-f3314d",
      "text": "Ten years since the Pullman strike, and the men still don't speak of it kindly."
    },
    {
      "voice": "gent",
      "kind": "remark",
      "id": "gent-remark-68f825",
      "text": "They've reversed the river and still the water tastes of it."
    },
    {
      "voice": "gent",
      "kind": "remark",
      "id": "gent-remark-225ce3",
      "text": "I remember when all of this was prairie and you could see the lake from the doorstep."
    },
    {
      "voice": "gent",
      "kind": "remark",
      "id": "gent-remark-0d12a6",
      "text": "The Fair brought the whole world to Chicago. Nothing has been quite so grand since."
    },
    {
      "voice": "gent",
      "kind": "remark",
      "season": "spring",
      "id": "gent-remark-d254b9",
      "text": "The lawn wants cutting already. Spring comes all at once in this city."
    },
    {
      "voice": "gent",
      "kind": "remark",
      "season": "summer",
      "id": "gent-remark-3e37d5",
      "text": "Hot as a boiler room. The family goes to the lake country next week, thank heaven."
    },
    {
      "voice": "gent",
      "kind": "remark",
      "season": "fall",
      "id": "gent-remark-e8e0f9",
      "text": "The leaves are down. Have the man rake the walk before someone slips."
    },
    {
      "voice": "gent",
      "kind": "remark",
      "season": "winter",
      "id": "gent-remark-b1ab7e",
      "text": "Bitter cold. Tell the coachman to put the blankets on the horses."
    },
    {
      "voice": "lady",
      "kind": "greet",
      "time": "morning",
      "id": "lady-greet-5c3e9f",
      "text": "Good morning."
    },
    {
      "voice": "lady",
      "kind": "greet",
      "time": "morning",
      "id": "lady-greet-2b8d78",
      "text": "Good morning. Isn't it a lovely morning?"
    },
    {
      "voice": "lady",
      "kind": "greet",
      "time": "afternoon",
      "id": "lady-greet-218fad",
      "text": "Good afternoon. Are you calling on someone?"
    },
    {
      "voice": "lady",
      "kind": "greet",
      "time": "afternoon",
      "id": "lady-greet-d30bd6",
      "text": "Good afternoon to you."
    },
    {
      "voice": "lady",
      "kind": "greet",
      "time": "evening",
      "id": "lady-greet-462267",
      "text": "Good evening."
    },
    {
      "voice": "lady",
      "kind": "greet",
      "id": "lady-greet-e86ada",
      "text": "How do you do?"
    },
    {
      "voice": "lady",
      "kind": "greet",
      "id": "lady-greet-3d7103",
      "text": "Oh! You startled me. Good day."
    },
    {
      "voice": "lady",
      "kind": "greet",
      "id": "lady-greet-6542da",
      "text": "Welcome to the Avenue. You must see the Glessner house. Everyone stares at it."
    },
    {
      "voice": "lady",
      "kind": "remark",
      "time": "morning",
      "id": "lady-remark-0d6b3c",
      "text": "I must write my calling list for Thursday before the morning gets away from me."
    },
    {
      "voice": "lady",
      "kind": "remark",
      "time": "afternoon",
      "id": "lady-remark-7e5142",
      "text": "The carriage will be round at three. We are calling on Mrs. Pullman."
    },
    {
      "voice": "lady",
      "kind": "remark",
      "id": "lady-remark-66e60d",
      "text": "Field's has the new spring silks in. I shall go down on Monday."
    },
    {
      "voice": "lady",
      "kind": "remark",
      "id": "lady-remark-9b72fe",
      "text": "The reading class meets on Monday. I haven't finished the chapter."
    },
    {
      "voice": "lady",
      "kind": "remark",
      "id": "lady-remark-f72ff1",
      "text": "Cook says the butcher sent the wrong cut again. I shall have to speak to him myself."
    },
    {
      "voice": "lady",
      "kind": "remark",
      "id": "lady-remark-1b3666",
      "text": "The new girl is very willing, but she broke the good gravy boat."
    },
    {
      "voice": "lady",
      "kind": "remark",
      "id": "lady-remark-4dd9c1",
      "text": "They say the whole of Chicago will move to the North Side in ten years. I shan't."
    },
    {
      "voice": "lady",
      "kind": "remark",
      "id": "lady-remark-4cefa2",
      "text": "I wouldn't go to a theater now for anything. Not since the Iroquois."
    },
    {
      "voice": "lady",
      "kind": "remark",
      "id": "lady-remark-3db733",
      "text": "The soot from those trains. I had the curtains washed only last week."
    },
    {
      "voice": "lady",
      "kind": "remark",
      "id": "lady-remark-678e0d",
      "text": "Such a lot of carriages today. There must be a reception at one of the houses."
    },
    {
      "voice": "lady",
      "kind": "remark",
      "season": "spring",
      "id": "lady-remark-dc40e6",
      "text": "The tulips are up at last. The gardener was right about the bed by the door."
    },
    {
      "voice": "lady",
      "kind": "remark",
      "season": "summer",
      "id": "lady-remark-869bb6",
      "text": "Too hot for calls. Everyone sensible has gone to the lake."
    },
    {
      "voice": "lady",
      "kind": "remark",
      "season": "fall",
      "id": "lady-remark-862075",
      "text": "We must have the furs brought out of storage."
    },
    {
      "voice": "lady",
      "kind": "remark",
      "season": "winter",
      "id": "lady-remark-755d58",
      "text": "The children will want to skate in the park. Tell Nurse to wrap them well."
    },
    {
      "voice": "young_man",
      "kind": "greet",
      "time": "morning",
      "id": "young_man-greet-d771eb",
      "text": "Morning!"
    },
    {
      "voice": "young_man",
      "kind": "greet",
      "time": "afternoon",
      "id": "young_man-greet-bedb71",
      "text": "Afternoon. Nice day for it."
    },
    {
      "voice": "young_man",
      "kind": "greet",
      "time": "evening",
      "id": "young_man-greet-1605fb",
      "text": "Evening."
    },
    {
      "voice": "young_man",
      "kind": "greet",
      "id": "young_man-greet-95e3ac",
      "text": "Hello there."
    },
    {
      "voice": "young_man",
      "kind": "greet",
      "id": "young_man-greet-389da0",
      "text": "How do you do. New to the neighborhood?"
    },
    {
      "voice": "young_man",
      "kind": "greet",
      "id": "young_man-greet-2d9a7b",
      "text": "Good day. If you're looking for the lake, it's that way, past the tracks."
    },
    {
      "voice": "young_man",
      "kind": "remark",
      "time": "morning",
      "id": "young_man-remark-4b04e5",
      "text": "Father wants me at the office by nine. I'll never make it."
    },
    {
      "voice": "young_man",
      "kind": "remark",
      "time": "evening",
      "id": "young_man-remark-f17081",
      "text": "There's a dance at the Calumet Club on Saturday. I mean to go."
    },
    {
      "voice": "young_man",
      "kind": "remark",
      "id": "young_man-remark-b8489b",
      "text": "Did you see that automobile? Forty miles an hour, they say, on an open road."
    },
    {
      "voice": "young_man",
      "kind": "remark",
      "id": "young_man-remark-f60ad4",
      "text": "The White Sox will take the pennant this year. You'll see."
    },
    {
      "voice": "young_man",
      "kind": "remark",
      "id": "young_man-remark-372007",
      "text": "Half the fellows from school are going to the Fair in St. Louis this summer."
    },
    {
      "voice": "young_man",
      "kind": "remark",
      "id": "young_man-remark-e9664e",
      "text": "I'd sooner ride a bicycle than sit in that stuffy carriage."
    },
    {
      "voice": "young_man",
      "kind": "remark",
      "id": "young_man-remark-69c23a",
      "text": "They say Roosevelt will win in a walk. I'd like to see him speak."
    },
    {
      "voice": "young_man",
      "kind": "remark",
      "id": "young_man-remark-1a00eb",
      "text": "Father says I'm to learn the business from the bottom. That means the warehouse."
    },
    {
      "voice": "young_man",
      "kind": "remark",
      "season": "summer",
      "id": "young_man-remark-847db6",
      "text": "Let's go down to the lake and swim off the breakwater."
    },
    {
      "voice": "young_man",
      "kind": "remark",
      "season": "winter",
      "id": "young_man-remark-7b0c65",
      "text": "The ice is thick enough on the lagoon in Washington Park. Skating tonight?"
    },
    {
      "voice": "young_lady",
      "kind": "greet",
      "time": "morning",
      "id": "young_lady-greet-33e888",
      "text": "Good morning!"
    },
    {
      "voice": "young_lady",
      "kind": "greet",
      "time": "afternoon",
      "id": "young_lady-greet-436f04",
      "text": "Good afternoon."
    },
    {
      "voice": "young_lady",
      "kind": "greet",
      "time": "evening",
      "id": "young_lady-greet-462267",
      "text": "Good evening."
    },
    {
      "voice": "young_lady",
      "kind": "greet",
      "id": "young_lady-greet-0f327c",
      "text": "Oh, hello. Are you visiting someone on the Avenue?"
    },
    {
      "voice": "young_lady",
      "kind": "greet",
      "id": "young_lady-greet-105825",
      "text": "How do you do? I don't believe we've met."
    },
    {
      "voice": "young_lady",
      "kind": "remark",
      "time": "morning",
      "id": "young_lady-remark-4eac4f",
      "text": "Mother says I must practice the piano for an hour before luncheon."
    },
    {
      "voice": "young_lady",
      "kind": "remark",
      "time": "afternoon",
      "id": "young_lady-remark-cd26e2",
      "text": "We're going down to Field's for gloves. Do come with us."
    },
    {
      "voice": "young_lady",
      "kind": "remark",
      "id": "young_lady-remark-005e3e",
      "text": "Did you hear? She's engaged, and to a man from New York."
    },
    {
      "voice": "young_lady",
      "kind": "remark",
      "id": "young_lady-remark-420518",
      "text": "I want to go to the Fair in St. Louis, but Father says it's too hot."
    },
    {
      "voice": "young_lady",
      "kind": "remark",
      "id": "young_lady-remark-3f8a2e",
      "text": "My dancing master says I lead. That's not a compliment."
    },
    {
      "voice": "young_lady",
      "kind": "remark",
      "id": "young_lady-remark-92388c",
      "text": "I've read every book in the house twice. I need a new one."
    },
    {
      "voice": "young_lady",
      "kind": "remark",
      "id": "young_lady-remark-10dc72",
      "text": "Mother says I'm to pour the tea at her at-home on Thursday."
    },
    {
      "voice": "young_lady",
      "kind": "remark",
      "id": "young_lady-remark-1d16d6",
      "text": "There's a lecture at the Art Institute on Thursday. I mean to go."
    },
    {
      "voice": "young_lady",
      "kind": "remark",
      "season": "spring",
      "id": "young_lady-remark-da9a89",
      "text": "It's warm enough to leave off my jacket. Almost."
    },
    {
      "voice": "young_lady",
      "kind": "remark",
      "season": "summer",
      "id": "young_lady-remark-fd6bf7",
      "text": "I'm going to ride my bicycle along the lake before it gets too hot."
    },
    {
      "voice": "young_lady",
      "kind": "remark",
      "season": "winter",
      "id": "young_lady-remark-ce2c39",
      "text": "My fingers are frozen, even through my muff."
    },
    {
      "voice": "manservant",
      "kind": "greet",
      "time": "morning",
      "id": "manservant-greet-944e3e",
      "text": "Morning to you."
    },
    {
      "voice": "manservant",
      "kind": "greet",
      "time": "morning",
      "id": "manservant-greet-498262",
      "text": "Good morning, sir. Or madam. Can I help you find a house?"
    },
    {
      "voice": "manservant",
      "kind": "greet",
      "time": "afternoon",
      "id": "manservant-greet-d0f10d",
      "text": "Afternoon."
    },
    {
      "voice": "manservant",
      "kind": "greet",
      "time": "evening",
      "id": "manservant-greet-2f0ccd",
      "text": "Evening. Mind the horses."
    },
    {
      "voice": "manservant",
      "kind": "greet",
      "id": "manservant-greet-ed7628",
      "text": "Good day."
    },
    {
      "voice": "manservant",
      "kind": "greet",
      "id": "manservant-greet-0334fd",
      "text": "Watch your step there. The horses have been along."
    },
    {
      "voice": "manservant",
      "kind": "greet",
      "id": "manservant-greet-4da5d7",
      "text": "If you're looking for the family, they're not at home to callers before three."
    },
    {
      "voice": "manservant",
      "kind": "remark",
      "time": "morning",
      "id": "manservant-remark-df1544",
      "text": "The master wants the carriage at half past eight sharp. Not a minute after."
    },
    {
      "voice": "manservant",
      "kind": "remark",
      "time": "morning",
      "id": "manservant-remark-843986",
      "text": "Coal wagon's due this morning. That'll mean dust in everything."
    },
    {
      "voice": "manservant",
      "kind": "remark",
      "time": "evening",
      "id": "manservant-remark-c9197f",
      "text": "One more drive tonight, to the theater and back, then my supper."
    },
    {
      "voice": "manservant",
      "kind": "remark",
      "id": "manservant-remark-26258c",
      "text": "That bay mare threw a shoe on the way back from Michigan Avenue."
    },
    {
      "voice": "manservant",
      "kind": "remark",
      "id": "manservant-remark-581b37",
      "text": "The ice man's late. Cook will have something to say about that."
    },
    {
      "voice": "manservant",
      "kind": "remark",
      "id": "manservant-remark-6a9a40",
      "text": "Brushed down two horses, cleaned the harness, and it's not yet ten."
    },
    {
      "voice": "manservant",
      "kind": "remark",
      "id": "manservant-remark-72f611",
      "text": "Another automobile. The horses hate them, and so do I."
    },
    {
      "voice": "manservant",
      "kind": "remark",
      "id": "manservant-remark-f9c79e",
      "text": "Thursday afternoon's mine. I'm off to see my brother on the West Side."
    },
    {
      "voice": "manservant",
      "kind": "remark",
      "id": "manservant-remark-876875",
      "text": "The master's in a temper. Something about the price of steel."
    },
    {
      "voice": "manservant",
      "kind": "remark",
      "id": "manservant-remark-e435a7",
      "text": "Mind that gate. It sticks in the damp and the family won't have it oiled."
    },
    {
      "voice": "manservant",
      "kind": "remark",
      "id": "manservant-remark-486122",
      "text": "My father drove a hack in the old town before the fire. Now look at me, on Prairie Avenue."
    },
    {
      "voice": "manservant",
      "kind": "remark",
      "season": "summer",
      "id": "manservant-remark-ba9a66",
      "text": "Flies are terrible in the stable this time of year."
    },
    {
      "voice": "manservant",
      "kind": "remark",
      "season": "winter",
      "id": "manservant-remark-c413b3",
      "text": "Snow again. I'll be clearing the walk all morning."
    },
    {
      "voice": "manservant",
      "kind": "remark",
      "season": "fall",
      "id": "manservant-remark-596cbe",
      "text": "Leaves in the gutters again. Raked them this morning."
    },
    {
      "voice": "maid",
      "kind": "greet",
      "time": "morning",
      "id": "maid-greet-5c3e9f",
      "text": "Good morning."
    },
    {
      "voice": "maid",
      "kind": "greet",
      "time": "morning",
      "id": "maid-greet-24bcba",
      "text": "Morning! Excuse me, I'm in a hurry with the post."
    },
    {
      "voice": "maid",
      "kind": "greet",
      "time": "afternoon",
      "id": "maid-greet-436f04",
      "text": "Good afternoon."
    },
    {
      "voice": "maid",
      "kind": "greet",
      "time": "evening",
      "id": "maid-greet-462267",
      "text": "Good evening."
    },
    {
      "voice": "maid",
      "kind": "greet",
      "id": "maid-greet-78b94b",
      "text": "Oh! Good day to you."
    },
    {
      "voice": "maid",
      "kind": "greet",
      "id": "maid-greet-90b615",
      "text": "Hello. Are you looking for someone? The tradesmen's door is round the side."
    },
    {
      "voice": "maid",
      "kind": "greet",
      "id": "maid-greet-ac6985",
      "text": "Good day. You'll want the front door if you're calling, and the bell on the right."
    },
    {
      "voice": "maid",
      "kind": "remark",
      "time": "morning",
      "id": "maid-remark-d2cd7c",
      "text": "Up at half past five, the fires laid, the steps scrubbed, and the family not yet down."
    },
    {
      "voice": "maid",
      "kind": "remark",
      "time": "morning",
      "id": "maid-remark-766b3a",
      "text": "The brass on the front door won't polish itself."
    },
    {
      "voice": "maid",
      "kind": "remark",
      "time": "afternoon",
      "id": "maid-remark-532a5e",
      "text": "Thursday afternoon at last. My good hat and Michigan Avenue."
    },
    {
      "voice": "maid",
      "kind": "remark",
      "time": "evening",
      "id": "maid-remark-ae4855",
      "text": "One more tray up the back stairs and then I'll put my feet up."
    },
    {
      "voice": "maid",
      "kind": "remark",
      "id": "maid-remark-ecb9aa",
      "text": "The missus wants the silver done before the dinner party."
    },
    {
      "voice": "maid",
      "kind": "remark",
      "id": "maid-remark-774eb4",
      "text": "Mary says the cook next door has given notice. Again."
    },
    {
      "voice": "maid",
      "kind": "remark",
      "origin": "swedish",
      "id": "maid-remark-e60537",
      "text": "I've a letter to post home to Sweden. My mother worries."
    },
    {
      "voice": "maid",
      "kind": "remark",
      "origin": "irish",
      "id": "maid-remark-7a72ac",
      "text": "I sent half my wages home to my mother in County Mayo."
    },
    {
      "voice": "maid",
      "kind": "remark",
      "id": "maid-remark-4c2baf",
      "text": "The young ladies have changed their dresses three times today."
    },
    {
      "voice": "maid",
      "kind": "remark",
      "id": "maid-remark-02cd7b",
      "text": "Don't tell anyone, but the master snores like a coal train."
    },
    {
      "voice": "maid",
      "kind": "remark",
      "id": "maid-remark-c4e2a0",
      "text": "All the maids on the Avenue know what goes on in every house. The ladies have no idea."
    },
    {
      "voice": "maid",
      "kind": "remark",
      "id": "maid-remark-98a2c2",
      "text": "The new carpet beater is here. My arms are aching already."
    },
    {
      "voice": "maid",
      "kind": "remark",
      "season": "spring",
      "id": "maid-remark-0fe38c",
      "text": "Spring cleaning. Every rug on the line and every curtain down."
    },
    {
      "voice": "maid",
      "kind": "remark",
      "season": "summer",
      "id": "maid-remark-a188a2",
      "text": "When the family goes to the lake, we'll have the house to ourselves."
    },
    {
      "voice": "maid",
      "kind": "remark",
      "season": "winter",
      "id": "maid-remark-6cf48e",
      "text": "My hands are raw from the washing in this cold."
    },
    {
      "voice": "cook",
      "kind": "greet",
      "time": "morning",
      "id": "cook-greet-f054cc",
      "text": "Good morning to you."
    },
    {
      "voice": "cook",
      "kind": "greet",
      "time": "afternoon",
      "id": "cook-greet-436f04",
      "text": "Good afternoon."
    },
    {
      "voice": "cook",
      "kind": "greet",
      "time": "evening",
      "id": "cook-greet-41f83f",
      "text": "Good evening, dear."
    },
    {
      "voice": "cook",
      "kind": "greet",
      "id": "cook-greet-c57cb4",
      "text": "Good day. You look hungry. Everyone does, to a cook."
    },
    {
      "voice": "cook",
      "kind": "greet",
      "id": "cook-greet-652af5",
      "text": "Oh, hello. If you're the grocer's boy, you're late."
    },
    {
      "voice": "cook",
      "kind": "remark",
      "time": "morning",
      "id": "cook-remark-ff65bb",
      "text": "The bread's been rising since five. It'll be on the table by eight."
    },
    {
      "voice": "cook",
      "kind": "remark",
      "time": "morning",
      "id": "cook-remark-c3da4a",
      "text": "The milk's turned. In this weather! I'll have words with the milkman."
    },
    {
      "voice": "cook",
      "kind": "remark",
      "time": "afternoon",
      "id": "cook-remark-7ffc06",
      "text": "Dinner for twelve tonight, and the fish not come yet."
    },
    {
      "voice": "cook",
      "kind": "remark",
      "time": "evening",
      "id": "cook-remark-7d8c4d",
      "text": "That's the last of the dishes. My feet are finished."
    },
    {
      "voice": "cook",
      "kind": "remark",
      "id": "cook-remark-593dab",
      "text": "The butcher's sent the wrong cut again. I'll go down myself tomorrow."
    },
    {
      "voice": "cook",
      "kind": "remark",
      "id": "cook-remark-6c0544",
      "text": "The grocer's boy is late again. Probably stopped to look at that automobile."
    },
    {
      "voice": "cook",
      "kind": "remark",
      "id": "cook-remark-7073dd",
      "text": "I've cooked for this family twenty years and the master still asks for his chop the same way."
    },
    {
      "voice": "cook",
      "kind": "remark",
      "id": "cook-remark-7d0c98",
      "text": "The new range is a wonder. It does everything except peel the potatoes."
    },
    {
      "voice": "cook",
      "kind": "remark",
      "id": "cook-remark-433c1b",
      "text": "Ice man's here. Mind the floor, he always drips on my clean floor."
    },
    {
      "voice": "cook",
      "kind": "remark",
      "id": "cook-remark-61ff03",
      "text": "Soup, fish, a joint, two sides, and a pudding. Every night, like clockwork."
    },
    {
      "voice": "cook",
      "kind": "remark",
      "id": "cook-remark-2139e0",
      "text": "That girl has broken two plates this week. Two!"
    },
    {
      "voice": "cook",
      "kind": "remark",
      "id": "cook-remark-a2c592",
      "text": "They're bringing the coal in. Close the kitchen windows or we'll all be black."
    },
    {
      "voice": "cook",
      "kind": "remark",
      "season": "summer",
      "id": "cook-remark-e26b3f",
      "text": "Too hot to light the stove, and the family wants a roast."
    },
    {
      "voice": "cook",
      "kind": "remark",
      "season": "fall",
      "id": "cook-remark-d4d22e",
      "text": "Apples from the country. Pies for a week."
    },
    {
      "voice": "cook",
      "kind": "remark",
      "season": "winter",
      "id": "cook-remark-dbe7bd",
      "text": "A good hot soup tonight. They'll all come in frozen."
    }
  ],
