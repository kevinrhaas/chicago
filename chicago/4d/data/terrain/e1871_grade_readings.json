  "usgs_3dep_1m_dem",
  "chicago_elevation_benchmarks"
 ],
 "datum": {
  "readings_in": "NAVD88 feet (the service's `value` in feet)",
  "internal": "data/datum.json: Z = 0 at the summer-1835 water surface, exported as 580.0 ft 'ASL'",
  "navd88_to_internal_ft": -580.0,
  "basis": "data/datum.json writes its export as ASL = Z + 580.0 and names no vertical datum for 'ASL'; this file takes NAVD88 as that datum, which is the datum the only modern elevations here are in, and says so rather than leaving it to be assumed. docs/research/01-terrain-hydrology.md sec 1.1 warns against mixing Chicago City Datum and NAVD88 figures, and the cross-check below is how that warning is honoured.",
  "ccd_to_navd88_ft": 579.2,
  "ccd_basis": "docs/research/01-terrain-hydrology.md sec 1.1: the Chicago Public Library's worked conversion (580.0 ft IGLD85 = 580.5 ft NAVD88 = 1.3 ft CCD) puts CCD 0 at 579.2 ft NAVD88; the 579.88 ft figure is on the obsolete mean-tide-New-York datum.",
  "cross_check": "City benchmark 289 (23rd Street at Michigan Avenue) is 13.572 ft CCD, fixed 1966 -> 592.77 ft NAVD88 by the conversion above. The 3DEP model reads 592.77 ft at the benchmark's own coordinates. The two agree to the hundredth of a foot, which is better than either can honestly claim and is enough to say the conversion and the model are the same datum."
 },
