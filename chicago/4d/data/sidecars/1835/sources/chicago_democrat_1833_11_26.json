ntity_id":"person_facts","entity_type":"decision","locator":null,"source_id":"chicago_democrat_1833_11_26","use":"research"},{"claim":"rows[148]","confidence":"inferred","entity_id":"person_facts","entity_type":"decision","locator":null,"source_id":"chicago_democrat_1833_11_26","use":"research"},{"claim":"rows[200]","confidence":"inferred","entity_id":"person_facts","entity_type":"decision","locator":null,"source_id":"chicago_democrat_1833_11_26","use":"research"},{"claim":"rows[481]","confidence":"inferred","entity_id":"person_facts","entity_type":"decision","locator":null,"source_id":"chicago_democrat_1833_11_26","use":"research"},{"claim":"rows[482]","confidence":"inferred","entity_id":"person_facts","entity_type":"decision","locator":null,"source_id":"chicago_democrat_1833_11_26","use":"research"},{"claim":"works_at","confidence":"attested","entity_id":"hh_calhoun_john","entity_type":"household","locator":null,"source_id":"chicago_democrat_1833_11_26","use":"scene"},{"claim":"works_at","confidence":"attested","entity_id":"hh_dole_george_w","entity_type":"household","locator":null,"source_id":"chicago_democrat_1833_11_26","use":"scene"},{"claim":"works_at","confidence":"attested","entity_id":"hh_elston_daniel","entity_type":"household","locator":null,"source_id":"chicago_democrat_1833_11_26","use":"scene"},{"claim":"works_at","confidence":"attested","entity_id":"hh_goss_cobb","entity_type":"household","locator":null,"source_id":"chicago_democrat_1833_11_26","use":"scene"},{"claim":"works_at","confidence":"attested","entity_id":"hh_jones_benjamin","entity_type":"household","locator":null,"source_id":"chicago_democrat_1833_11_26","use":"scene"},{"claim":"works_at","confidence":"inferred","entity_id":"hh_harmon_brothers","entity_type":"household","locator":null,"source_id":"chicago_democrat_1833_11_26","use":"scene"},{"claim":"works_at","confidence":"inferred","entity_id":"hh_kimball_walter","entity_type":"household","locator":null,"source_id":"chicago_democrat_1833_11_26","use":"scene"}],"source":{"archived_url":"","citation":"The Chicago Democrat. Vol. I, No. 1. Chicago, Ill.: John Calhoun, Tuesday, November 26, 1833.","source_id":"chicago_democrat_1833_11_26","tier":1,"tier_label":"period/eyewitness","url":"","what_it_does_not_supply":["any building's dimensions","any building's form, material, storey count or fenestration","the specific corner of any junction it names — the imprint says 'on the corner of', and which of the four is not in the sentence","evidence that any building named here still stood on 1835-07-01 — this issue is NINETEEN MONTHS before the scene date, in the town's fastest-changing period, and the population went from 800 to 3,265 in between","any building footprint or plan","any length or width for the piers","any corroboration of the estray pen — see the negative finding in the note"],"what_it_supplies":["that a named trade was being carried on in Chicago in November 1833","the Chicago Democrat's own address, self-reported: the corner of South Water and Clark streets","Philo Carpenter advertising drugs, medicines, oils, paints and dye-stuffs, dated Nov. 22, 1833 — with NO address, so it cannot disambiguate his two shops","C. & I. Harmon advertising dry goods, crockery, hardware and wet and dry groceries, dated Nov. 18, 1833 — with NO address, so it does NOT corroborate the Clark/South Water corner Andreas gives them","W. Kimball's 'New Store' at the corner of South Water and Clark — a SECOND, independently attested occupant of that junction in the same issue, signed","Peter Cohen, clothier and grocer, self-reported at the EAST END OF SOUTH WATER-STREET, and trading in Chicago before Nov 1833 ('old customers ... past favors')","Goss & Cobb, saddle and harness makers, self-reported on the corner of Lake and Canal streets","Matthias Mason & Co., blacksmiths, on 'Main-street, nearly opposite Graves' Tavern' — a street name this project does not otherwise hold","B. Jones, grocery and provision store, and separately a storage/forwarding/commission business — both ads give NO street","Newberry & Dole, forwarding and commission merchants — no address","John Wright, cut nails and general merchandise; and TWO BUILDINGS TO LET until 1 June 1834","Daniel Elston & [illegible], soap and candle manufactory, paying cash for tallow and house ashes","a tavern stand kept by Chester Ingersoll, 'lately occupied by Mr. Wm. W. WATTLES', dated 4 October 1833","the house of Chester Ingersoll used as the district polling place, 9 December 1833","THE VILLAGE ORDINANCES of 7 November 1833, complete — the richest single item in the paper","Ordinance 1: the corporate limits surveyed ALONG the northern United States' Pier 'to the termination thereof' — the pier as an existing, walkable structure with a definite landward end","Ordinance 5: 'either of the bridges in said town' and their 'plank or any piece of timber' — EXACTLY TWO bridges on 7 Nov 1833, of plank-and-timber construction","Ordinance 6: wooden buildings with wooden and lath-and-plaster partitions, heated by STOVES not fireplaces, pipes passing through roof or side wall and carried 18 inches above the roof, guarded by stone-ware pipe, brick, tin or sheet iron","Ordinance 9: timber, stone, brick, boxes and barrels stacked in the streets","Ordinances 3, 7 and 8: hogs at large, horses run through the streets, stallions","the schooner Austerlitz, Capt. Smith, from Buffalo, arrived about the 1[9]th inst. with a full cargo of merchandise for citizens of this village and cleared on the 21st IN BALLAST","a school established in the village by Mr. Sproat of Boston, already running on 26 Nov 1833","a public auction of United States property held AT FORT DEARBORN, 2 December 1833","the village population passing 'more than eight hundred souls' in late 1833"]},"uses":["scene","exclusion","research"]}
