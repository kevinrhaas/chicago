  "provenance": {
    "grade": "reconstructed",
    "basis": "Reconstructed walking depiction of Christine Nelson, parlor maid in the Glessner household (inferred: the 1900 census enumerates her in the house as a servant, \"Parlor maid\", born March 1873 in Sweden, came 1892, single; no source read says she was still there on 1 July 1904), walking round the Glessner block on its sidewalks with a market basket in her left hand, as if back from market: up Prairie Avenue past the front of the house, west along Eighteenth Street past the great arch (the service entrance, Glessner's The Story of a House, 1923) and the stable doors, stepping out toward the kerb past the two staff who stand there, then south down Indiana Avenue, east along Twentieth Street and north up Prairie again, about 730 m, some twenty minutes at the walk's own pace, and round again. Her white shirtwaist, navy walking skirt, belt, bow and straw sailor hat are built after the Met's shirtwaist and boater, Bain's 1909 working women and Shinn's 1904 drawing (T-3481); the basket is reconstructed. That she went to market, the way she walks and when, her face, hair and complexion are reconstructed: no picture of her is known.",
    "sources": [
      "census_1900_chicago_t623_roll245",
      "glessner_story_of_a_house_1923",
      "met_ci_1900_cotton_shirtwaist",
      "loc_bain_1909_shirtwaist_strikers_group",
      "loc_shinn_1904_misfit_sailor_hats_drawing",
      "met_ci_1890_straw_boater",
      "loc_underwood_1903_state_street_noonday_stereograph"
    ],
    "liberty": "L418",
    "seed": "pa1904_glessner_john_j_c1900_christine_nelson:1904:block-walk-from-market:20261107",
    "replaceable_by": "A photograph of Christine Nelson or of the Glessner staff, or a record that she was or was not in the house in 1904, or of where the household bought its food; her walk round the block and her basket have no documentary claim."
  }
