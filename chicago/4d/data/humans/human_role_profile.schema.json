{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymous adult role profile; never a historical resident",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "identity_kind",
    "label",
    "age_group",
    "roles",
    "period",
    "eligible_assets",
    "provenance",
    "fallback_only"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^anonymous_[a-z0-9_]+$"
    },
    "identity_kind": {
      "const": "anonymous"
    },
    "label": {
      "type": "string",
      "minLength": 10
    },
    "age_group": {
      "const": "adult"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "standing",
          "walking",
          "driver",
          "rider"
        ]
      }
    },
    "period": {
      "$ref": "#/$defs/period"
    },
    "eligible_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "period",
          "wardrobe_basis"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "period": {
            "$ref": "#/$defs/period"
          },
          "wardrobe_basis": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grade",
        "basis",
        "liberty"
      ],
      "properties": {
        "grade": {
          "const": "reconstructed"
        },
        "basis": {
          "type": "string",
          "minLength": 20
        },
        "liberty": {
          "const": "L418"
        }
      }
    },
    "fallback_only": {
      "const": true
    }
  },
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "earliest_year",
        "latest_year"
      ],
      "properties": {
        "earliest_year": {
          "type": "integer",
          "minimum": 1600,
          "maximum": 2100
        },
        "latest_year": {
          "type": "integer",
          "minimum": 1600,
          "maximum": 2100
        }
      }
    }
  }
}
