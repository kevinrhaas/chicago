{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chicago4d/schemas/human_instance.schema.json",
  "title": "4D Chicago human instance",
  "description": "A portable human instance binds either an existing person_id OR an explicit anonymous adult role profile. Anonymous roles never mint residents. Schema and tools/human_contract.py enforce profile/date/asset-wardrobe eligibility; no scene placements are supplied by this contract.",
  "type": "object",
  "required": [
    "id",
    "contract_version",
    "scene",
    "appearance",
    "placement",
    "animation",
    "behaviour",
    "interaction",
    "lod",
    "display",
    "review_required",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^hi_[a-z0-9_]+$",
      "description": "Stable instance id, `hi_<person_id>_<scene>` by convention. One person may stand in a scene once."
    },
    "contract_version": {
      "const": 1
    },
    "scene": {
      "type": "string",
      "pattern": "^[0-9]{4}$",
      "description": "The scene this instance belongs to (data/scenes/<scene>.json). A scene with no instance file draws no human: nothing is inherited across years."
    },
    "person_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "An existing person record (data/sidecars/<scene>/people.json). This file never mints a person; identity stays with the residents layer."
    },
    "appearance": {
      "type": "object",
      "required": [
        "asset_id"
      ],
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "The human asset: files `<asset_id>.lod<N>.glb`. Several people may share a generic body."
        },
        "variants": {
          "type": "object",
          "description": "Material slot \u2192 variant, selecting `<slot>__<variant>` from the asset (clothing, hair).",
          "propertyNames": {
            "pattern": "^[a-z_]+$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        }
      }
    },
    "placement": {
      "type": "object",
      "required": [
        "local_e",
        "local_n",
        "heading_deg",
        "anchor"
      ],
      "additionalProperties": false,
      "properties": {
        "local_e": {
          "type": "number",
          "description": "Metres east of the scene datum (the walker's frame)."
        },
        "local_n": {
          "type": "number",
          "description": "Metres north of the scene datum."
        },
        "heading_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360,
          "description": "Facing, degrees clockwise from grid north. The asset faces +Z, so in three.js rotation.y = PI - heading_deg * PI / 180."
        },
        "anchor": {
          "enum": [
            "terrain",
            "walk_surface"
          ],
          "description": "terrain: feet on the scene's heightfield; walk_surface: on a structure's placement.walk_surface_m (a bridge deck)."
        },
        "structure_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "Required with anchor walk_surface: the structure whose surface is stood on."
        }
      }
    },
    "animation": {
      "type": "object",
      "required": [
        "clip"
      ],
      "additionalProperties": false,
      "properties": {
        "clip": {
          "type": "string",
          "pattern": "^[a-z]+(_[a-z0-9]+)*$",
          "description": "The clip playing now."
        },
        "loop": {
          "type": "boolean",
          "default": true
        },
        "phase": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Start offset as a share of the clip, so a crowd is not in step."
        }
      }
    },
    "behaviour": {
      "type": "object",
      "required": [
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "standing",
            "walking",
            "working",
            "seated",
            "talking"
          ],
          "description": "What the person is doing; the renderer chooses clips for a state, the record does not script them."
        },
        "route": {
          "type": "array",
          "description": "Waypoints for `walking`, in the same frame as placement.",
          "items": {
            "type": "object",
            "required": [
              "local_e",
              "local_n"
            ],
            "additionalProperties": false,
            "properties": {
              "local_e": {
                "type": "number"
              },
              "local_n": {
                "type": "number"
              }
            }
          }
        },
        "duty": {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "description": "T-3490: a duty shared with others, played by renderers/web/js/human-duties.js. `knot`: men of one `id` standing together talking (placement is his place in it, facing in), who now and then each walk to `away`, stand a while and come back. `beat`: a sentry walking between his placement and `to`, pausing at each end facing `face_deg`. `rank`: men of one `id` drawn up still, hands at their sides, looking at the one marked `lead`, who speaks to them now and then. No words are said (L1).",
          "properties": {
            "kind": {
              "enum": [
                "knot",
                "beat",
                "rank"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            "lead": {
              "type": "boolean"
            },
            "away": {
              "type": "object",
              "required": [
                "local_e",
                "local_n",
                "heading_deg"
              ],
              "additionalProperties": false,
              "properties": {
                "local_e": {
                  "type": "number"
                },
                "local_n": {
                  "type": "number"
                },
                "heading_deg": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 360
                },
                "via": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "local_e",
                      "local_n"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "local_e": {
                        "type": "number"
                      },
                      "local_n": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            },
            "to": {
              "type": "object",
              "required": [
                "local_e",
                "local_n"
              ],
              "additionalProperties": false,
              "properties": {
                "local_e": {
                  "type": "number"
                },
                "local_n": {
                  "type": "number"
                }
              }
            },
            "face_deg": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 360
            },
            "pause_s": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "beat"
                  }
                }
              },
              "then": {
                "required": [
                  "to"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "enum": [
                      "knot",
                      "rank"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "id"
                ]
              }
            }
          ]
        },
        "hours": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 24
          },
          "description": "T-3490: local solar hours [from, to) the person is out (`to` may pass midnight); outside them they are in quarters, not drawn (renderers/web/js/human-duties.js). Absent: always out."
        },
        "presence": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "description": "T-3463: the ISO dates (inclusive; either may be left out) the person is in the scene at all; off them they are nowhere (renderers/web/js/human-days.js). Jean Lalime is until 1812-06-17."
        },
        "day": {
          "type": "array",
          "minItems": 1,
          "description": "T-3463: the person's day, played by renderers/web/js/human-days.js: the first variant whose `dates` hold the scene's date (or that has none). Its spans cover 0-24 local solar hours: indoors in `where` (not drawn; its door offers Ask for them) or out at `at` doing `activity`. A variant with `chance` comes only so often (seeded by the person and the date; on the other dates they are away); `dates` may add `months` and `years` (a run of years the months recur in).",
          "items": {
            "type": "object",
            "required": [
              "spans"
            ],
            "additionalProperties": false,
            "properties": {
              "dates": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "from": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "months": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 12
                    }
                  },
                  "years": {
                    "type": "object",
                    "additionalProperties": false,
                    "minProperties": 1,
                    "properties": {
                      "from": {
                        "type": "integer"
                      },
                      "to": {
                        "type": "integer"
                      }
                    }
                  }
                }
              },
              "note": {
                "type": "string"
              },
              "spans": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "from",
                    "to",
                    "indoors"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "from": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 24
                    },
                    "to": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 24
                    },
                    "indoors": {
                      "type": "boolean"
                    },
                    "where": {
                      "type": "string",
                      "pattern": "^[a-z0-9_]+$",
                      "description": "The structure they are in (indoors) or at."
                    },
                    "at": {
                      "type": "object",
                      "required": [
                        "local_e",
                        "local_n",
                        "heading_deg"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "local_e": {
                          "type": "number"
                        },
                        "local_n": {
                          "type": "number"
                        },
                        "heading_deg": {
                          "type": "number",
                          "minimum": 0,
                          "exclusiveMaximum": 360
                        }
                      }
                    },
                    "activity": {
                      "enum": [
                        "stand",
                        "talk",
                        "work",
                        "walk"
                      ]
                    },
                    "knot": {
                      "type": "string",
                      "pattern": "^[a-z0-9_]+$"
                    },
                    "spots": {
                      "type": "array",
                      "maxItems": 6,
                      "items": {
                        "type": "object",
                        "required": [
                          "local_e",
                          "local_n"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "local_e": {
                            "type": "number"
                          },
                          "local_n": {
                            "type": "number"
                          }
                        }
                      }
                    },
                    "to_point": {
                      "type": "object",
                      "required": [
                        "local_e",
                        "local_n"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "local_e": {
                          "type": "number"
                        },
                        "local_n": {
                          "type": "number"
                        }
                      }
                    },
                    "doing": {
                      "type": "string",
                      "description": "A short plain phrase of what they are about, for the card and the harness."
                    },
                    "away": {
                      "type": "boolean",
                      "description": "Off the scene for the span (gone out with the column, away at Milwaukee): not drawn, not asked for."
                    },
                    "via": {
                      "type": "array",
                      "maxItems": 24,
                      "items": {
                        "type": "object",
                        "required": [
                          "local_e",
                          "local_n"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "local_e": {
                            "type": "number"
                          },
                          "local_n": {
                            "type": "number"
                          }
                        }
                      },
                      "description": "A walk's way from `at` to `to_point`, point by point (a path the reading draws)."
                    },
                    "once": {
                      "type": "boolean",
                      "description": "A walk made once, from `at` by `via` to `to_point`, where they then stand."
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "indoors": {
                            "const": true
                          },
                          "away": {
                            "not": {
                              "const": true
                            }
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "where"
                        ]
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "indoors": {
                            "const": false
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "at"
                        ]
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "activity": {
                            "const": "talk"
                          }
                        },
                        "required": [
                          "activity"
                        ]
                      },
                      "then": {
                        "required": [
                          "knot"
                        ]
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "activity": {
                            "const": "walk"
                          }
                        },
                        "required": [
                          "activity"
                        ]
                      },
                      "then": {
                        "required": [
                          "to_point"
                        ]
                      }
                    }
                  ]
                }
              },
              "chance": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1,
                "description": "The share of the dates in `dates` on which this day comes (\"about one day in five\" = 0.2); seeded, the same on every load."
              }
            }
          }
        },
        "quarters": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "T-3463: the building a man with `hours` is in outside them; its door offers Ask for him then."
        },
        "ask_order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99,
          "description": "T-3463: where in a door's Ask for list the person comes (lower first; 50 when unsaid)."
        }
      }
    },
    "interaction": {
      "type": "object",
      "required": [
        "selectable"
      ],
      "additionalProperties": false,
      "properties": {
        "selectable": {
          "type": "boolean"
        },
        "radius_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20,
          "description": "How near a visitor must come for `opens` to fire."
        },
        "opens": {
          "enum": [
            "resident_card",
            "none",
            "role_card"
          ],
          "description": "What meeting the person does. The resident card is the person record's own card; no dialogue is defined here (L1: no invented dialogue)."
        }
      }
    },
    "lod": {
      "type": "object",
      "required": [
        "policy"
      ],
      "additionalProperties": false,
      "properties": {
        "policy": {
          "enum": [
            "auto",
            "fixed"
          ]
        },
        "fixed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "With policy fixed: the one LOD drawn at every distance."
        }
      }
    },
    "display": {
      "enum": [
        "withheld",
        "shown"
      ],
      "description": "withheld: the record exists and nothing is drawn. shown is refused while data/humans/contract.json \u00a7 l1.in_force is true. Review metadata must be preserved but does not itself block display."
    },
    "review_required": {
      "type": "boolean",
      "description": "Carried from the person record and never dropped: a person whose record is review_required (or touches_removal) has an instance that is too."
    },
    "provenance": {
      "type": "object",
      "required": [
        "grade",
        "basis"
      ],
      "additionalProperties": false,
      "properties": {
        "grade": {
          "enum": [
            "attested",
            "inferred",
            "reconstructed"
          ],
          "description": "The grade of the DEPICTION \u2014 this body, these clothes, standing here doing this \u2014 not of the person, whose own grade lives on their record."
        },
        "basis": {
          "type": "string",
          "minLength": 20,
          "description": "What it rests on, or what bounded the invention."
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "seed": {
          "type": "string",
          "description": "The seed of any stochastic choice (variant, phase, placement jitter)."
        },
        "replaceable_by": {
          "type": "string",
          "description": "What evidence would replace this depiction."
        },
        "liberty": {
          "type": "string",
          "pattern": "^L[0-9]+$",
          "description": "The docs/LIBERTIES.md entry, for a reconstructed depiction."
        }
      }
    },
    "anonymous_profile_id": {
      "type": "string",
      "pattern": "^anonymous_[a-z0-9_]+$",
      "description": "Explicit anonymous role profile, never a resident/person id."
    },
    "role": {
      "enum": [
        "standing",
        "walking",
        "driver",
        "rider"
      ]
    },
    "fallback_basis": {
      "type": "string",
      "minLength": 40,
      "description": "Why no suitable existing person can serve this role; anonymous use is a documented fallback."
    },
    "considered_person_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      },
      "description": "Existing people evaluated for this role; empty only with an explicit no-candidate explanation in fallback_basis."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "placement": {
            "properties": {
              "anchor": {
                "const": "walk_surface"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "placement": {
            "required": [
              "structure_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lod": {
            "properties": {
              "policy": {
                "const": "fixed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "lod": {
            "required": [
              "fixed"
            ]
          }
        }
      }
    }
  ],
  "oneOf": [
    {
      "required": [
        "person_id"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "anonymous_profile_id"
            ]
          },
          {
            "required": [
              "role"
            ]
          }
        ]
      },
      "properties": {
        "interaction": {
          "properties": {
            "opens": {
              "enum": [
                "resident_card",
                "none"
              ]
            }
          }
        }
      }
    },
    {
      "required": [
        "anonymous_profile_id",
        "role",
        "fallback_basis",
        "considered_person_ids"
      ],
      "not": {
        "required": [
          "person_id"
        ]
      },
      "properties": {
        "interaction": {
          "properties": {
            "opens": {
              "enum": [
                "role_card",
                "none"
              ]
            }
          }
        },
        "provenance": {
          "properties": {
            "grade": {
              "const": "reconstructed"
            }
          }
        }
      }
    }
  ]
}
