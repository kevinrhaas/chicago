  "notable": [
    {
      "text": "Their daughter Frances later built the Nutshell Studies. Police still train with these tiny model crime scenes.",
      "about": "person",
      "surprising": true,
      "grade": "attested",
      "sources": [
        "glessner_house_family_page"
      ]
    },
    {
      "text": "On the first day of digging, George, then 14, and Frances, 8, threw the first soil from the foundation trenches.",
      "about": "person",
      "surprising": true,
      "grade": "attested",
      "sources": [
        "glessner_story_of_a_house_1923"
      ]
    },
    {
      "text": "Richardson died in April 1886, about five weeks before the digging began. He never saw the house built.",
      "about": "person",
      "surprising": true,
      "grade": "attested",
      "sources": [
        "glessner_house_richardson_page",
        "glessner_story_of_a_house_1923",
        "habs_glessner_house_il_1015_data_pages"
      ]
    },
    {
      "text": "The family moved in by the courtyard entrance on the alley. The neighbors had not even guessed they were moving.",
      "about": "structure",
      "surprising": true,
      "grade": "attested",
      "sources": [
        "glessner_story_of_a_house_1923"
      ]
    },
    {
      "text": "In 1904 Frances Glessner set up a silversmith's workbench in the basement.",
      "about": "person",
      "grade": "attested",
      "sources": [
        "glessner_house_family_page"
      ]
    },
    {
      "text": "In December 1966 a group of architects and preservationists bought the house for $35,000 to save it.",
      "about": "structure",
      "grade": "attested",
      "sources": [
        "glessner_house_current_status"
      ]
    }
  ],
