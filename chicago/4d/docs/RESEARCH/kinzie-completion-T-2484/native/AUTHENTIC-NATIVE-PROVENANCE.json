  "blender_pin": {
    "archive_sha256": "975c58fcb244273838534bba771e64ad87739216b0f9b39a888531a49a72d845",
    "raw": "# Pinned Blender for the content build. tools/bake.sh verifies the hash before use.\n#\n# Pinned to an exact binary rather than a version range because bpy is a stateful\n# tool whose defaults and operators shift between releases; version pinning is what\n# buys back determinism. The bpy pip wheel is a documented fallback, but the binary\n# is preferred: the wheel hard-couples Blender's minor version to a specific CPython,\n# which makes agent sandboxes fragile.\n#\n# Verified working 2026-08-09: headless geometry, custom float attributes, smart UV\n# project, Cycles CPU AO bake, GLB export \u2014 all green in ~0.8 s for a test mesh.\n\nBLENDER_VERSION=4.5.3\nBLENDER_URL=https://download.blender.org/release/Blender4.5/blender-4.5.3-linux-x64.tar.xz\nBLENDER_SHA256=975c58fcb244273838534bba771e64ad87739216b0f9b39a888531a49a72d845\nBLENDER_DIR=blender-4.5.3-linux-x64\n\n# Fallback, if the binary cannot run in a given environment:\n#   pip install bpy==4.5.*        # requires Python 3.11\n",
    "version": "4.5.3"
  },
